<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Shell-local replacements for the Material3 color attributes and theme parents
      that com.google.android.material normally provides. The shell module dropped
      the material library (it only ever powered two HTTP-auth password dialogs),
      but app/src/main/res/values/themes.xml is shared with the host and still
      references these names — declaring them here keeps aapt linking intact.
      colorPrimary / colorOnPrimary / colorError come from appcompat, which stays.
    -->
    <attr name="colorPrimaryContainer" format="color" />
    <attr name="colorOnPrimaryContainer" format="color" />
    <attr name="colorSecondary" format="color" />
    <attr name="colorSecondaryContainer" format="color" />
    <attr name="colorOnSecondary" format="color" />
    <attr name="colorTertiary" format="color" />
    <attr name="colorTertiaryContainer" format="color" />
    <attr name="colorOnTertiary" format="color" />
    <attr name="colorErrorContainer" format="color" />
    <attr name="colorOnError" format="color" />
    <attr name="colorOnBackground" format="color" />
    <attr name="colorSurface" format="color" />
    <attr name="colorOnSurface" format="color" />
    <attr name="colorSurfaceVariant" format="color" />
    <attr name="colorOnSurfaceVariant" format="color" />
    <attr name="colorOutline" format="color" />
    <attr name="colorOnPrimary" format="color" />

    <!-- Theme.Material3.* parents referenced by the shared themes.xml resolve to
         AppCompat here: shell screens are WebView/Compose, not material widgets. -->
    <style name="Theme.Material3.DayNight" parent="Theme.AppCompat.DayNight" />
    <style name="Theme.Material3.DayNight.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar" />
    <style name="Theme.Material3.Light" parent="Theme.AppCompat.Light" />
    <style name="Theme.Material3.Light.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar" />
    <style name="Theme.Material3.Dark" parent="Theme.AppCompat" />
    <style name="Theme.Material3.Dark.NoActionBar" parent="Theme.AppCompat.NoActionBar" />
</resources>
